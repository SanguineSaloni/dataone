# Prefer an authenticated CLI profile for local development.
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_CONFIG_PROFILE=your-profile

# If your organization requires a PAT locally, put DATABRICKS_TOKEN only in
# the ignored .env file. Never add a real token here or to browser code.

DATABRICKS_WAREHOUSE_ID=your_sql_warehouse_id
DATABRICKS_VOLUME_FILES=workspace.catalog_schema.volume_name
DATABRICKS_JOB_ID=your_job_id
DATABRICKS_GENIE_SPACE_ID=your_genie_space_id
DATABRICKS_APP_PORT=8000
DATABRICKS_APP_NAME=dataone-secure

# Unity Catalog connection names are supplied by Databricks App resource
# bindings in production. Set them locally only after those connections exist.
DATABRICKS_SOURCE_CONNECTION=your_mysql_connection_name
DATABRICKS_TARGET_CONNECTION=your_postgresql_connection_name
DATAONE_SOURCE_ENGINE=mysql
DATAONE_SOURCE_FOREIGN_CATALOG=your_mysql_foreign_catalog
DATAONE_SOURCE_DEFAULT_SCHEMA=your_mysql_database
DATAONE_TARGET_ENGINE=postgresql
DATAONE_TARGET_DEFAULT_SCHEMA=public

# Local development may point to the same AWS PostgreSQL operational database
# used by the deployed app. Keep the complete URL only in the ignored .env file.
DATAONE_DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
DATAONE_REQUIRE_OPERATIONAL_STORE=true
# Comma-separated Databricks users allowed to onboard external AWS MySQL sources.
DATAONE_CONNECTION_ADMIN_EMAILS=admin@example.com
# Development-only identity used when the local server is not behind the
# Databricks Apps authentication proxy. It must also appear in the admin list.
DATAONE_LOCAL_USER_EMAIL=admin@example.com
